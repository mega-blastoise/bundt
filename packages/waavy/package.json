{
  "name": "@bundt/waavy",
  "version": "0.3.0-dev.0",
  "type": "module",
  "description": "React SSR for non-JavaScript server environments.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mega-blastoise/bundt.git",
    "directory": "packages/waavy"
  },
  "homepage": "https://github.com/mega-blastoise/bundt/tree/main/packages/waavy",
  "bugs": {
    "url": "https://github.com/mega-blastoise/bundt/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "react",
    "server-rendering",
    "ssr",
    "hydration",
    "waavy",
    "bun"
  ],
  "bin": {
    "waavy": "./bin/waavy.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./entry-server": {
      "types": "./dist/entry-server.d.ts",
      "import": "./dist/entry-server.js",
      "default": "./dist/entry-server.js"
    },
    "./protocol.schema.json": "./dist/protocol.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "bun run build:bundle && bun run build:types",
    "build:bundle": "bun build/index.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:binary": "bun build/binary.ts",
    "build:binaries": "bun build/binaries.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run build:binary && bun test src test",
    "test:e2e": "bun test e2e",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@bundt/internal-build-utils": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.64.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.0"
  }
}
